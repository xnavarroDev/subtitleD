POSTGRES_DB=subtitled
POSTGRES_USER=subtitle
POSTGRES_PASSWORD=subtitle

DATABASE_URL=postgresql+psycopg2://subtitle:subtitle@postgres:5432/subtitled
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_DIR=/app/storage
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

# WhisperX diarization uses gated pyannote models from Hugging Face.
# Use a Hugging Face read token after accepting access conditions for:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# https://huggingface.co/pyannote/segmentation-3.0
ASR_QUALITY_PRESET=balanced
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL_DIR=/app/storage/models
WHISPERX_BATCH_SIZE=16
WHISPERX_DIARIZE=false
WHISPER_MODEL_CACHE_SIZE=1
WHISPERX_JA_ALIGN_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-japanese
WHISPERX_JA_ALIGN_REVISION=2785e99ab97df77a32b5bd0ece5c9fa188a02f19
WHISPERX_JA_REQUIRE_SAFETENSORS=true
WHISPERX_ALIGNMENT_FAILURE_MODE=fallback
HF_HOME=/app/storage/models/huggingface
TORCH_HOME=/app/storage/models/torch
XDG_CACHE_HOME=/app/storage/models/cache
HF_TOKEN=

# NLLB is local and noncommercial (CC-BY-NC-4.0). Run setup-local-translation explicitly.
TRANSLATION_PROVIDER=routed
TRANSLATION_DEFAULT_PROVIDER=nllb-ct2
TRANSLATION_ROUTE_OVERRIDES=ja>en=libretranslate,fr>en=libretranslate
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_LOAD_ONLY=en,es,fr,de,pt,it,ja
LIBRETRANSLATE_UPDATE_MODELS=true
TRANSLATION_TIMEOUT_SECONDS=30
LOCAL_MT_MODEL=facebook/nllb-200-distilled-600M
LOCAL_MT_MODEL_REVISION=b3bbac6cd67efa90e0fcbe4c882ec79cfd782a17
LOCAL_MT_REQUIRE_SAFETENSORS=true
LOCAL_MT_MODEL_DIR=/app/storage/models/nllb-200-distilled-600M-ct2
LOCAL_MT_TOKENIZER_DIR=/app/storage/models/nllb-200-distilled-600M-tokenizer
LOCAL_MT_DEVICE=cpu
LOCAL_MT_COMPUTE_TYPE=int8
LOCAL_MT_BATCH_SIZE=4
LOCAL_MT_BEAM_SIZE=4
LOCAL_MT_MAX_INPUT_TOKENS=512
LOCAL_MT_TOKENIZER_CACHE_SIZE=8

# Reserved OpenAI-compatible local LLM integration for future features.
# Use port 5002 for KoboldCpp because LibreTranslate publishes host port 5001.
LLM_BASE_URL=http://host.docker.internal:5002/v1
LLM_API_KEY=
LLM_MODEL=local-model
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_RETRIES=1
LLM_JSON_MODE=false
TRANSLATION_UNIT_MAX_SECONDS=12
SOURCE_RECONSTRUCTION_MAX_GAP_SECONDS=0.2
SOURCE_RECONSTRUCTION_MAX_FRAGMENT_CHARS=2
SOURCE_REVIEW_CONFIDENCE_THRESHOLD=0.45

CAPTION_MAX_DURATION_SECONDS=6
CAPTION_MAX_CHARS=84
CAPTION_LINE_CHARS=42
CAPTION_PAUSE_SECONDS=0.65

DIAGNOSTICS_TIMEOUT_SECONDS=2
DIAGNOSTICS_DEEP_CACHE_TTL_SECONDS=300
WORKER_PING_TIMEOUT_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=15
WORKER_HEARTBEAT_KEY_PREFIX=subtitled:workers:heartbeat:
MIN_FREE_STORAGE_BYTES=1073741824
